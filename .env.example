# Copy this file to .env and fill in real values before running docker compose.
# .env is git-ignored and must never be committed.

# JWT signing secret — must be a long random string in production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret

# Demo user passwords (assessment only — use a real user store in production)
ALICE_PASSWORD=change-me
BOB_PASSWORD=change-me
